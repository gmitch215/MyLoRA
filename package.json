{
  "private": true,
  "name": "mylora",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "bunx nuxi dev --no-restart --public --port 8787",
    "dev:test": "NODE_OPTIONS='--max-old-space-size=8192' bunx nuxi dev --no-restart --public --port 8787 --dotenv .config/test.env",
    "dev:setup": "rm -rf .data-setup && NUXT_IGNORE_LOCK=1 NUXT_BUILD_DIR=.nuxt-setup NUXT_VITE_CACHE=node_modules/.cache/vite-setup NODE_OPTIONS='--max-old-space-size=4096' bunx nuxi dev --no-restart --public --port ${MYLORA_SETUP_PORT:-8788} --dotenv .config/setup.env",
    "dev:cloudflare": "bun run build && wrangler dev --local --port 8787",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "build:e2e": "MYLORA_E2E_BUILD=1 MYLORA_MOCK_CF=1 MYLORA_MAIL_SINK=1 NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "preview:e2e": "NODE_ENV=test PORT=8787 NITRO_PORT=8787 NODE_V8_COVERAGE=.coverage/server-raw node --env-file=.config/test.env tests/e2e/preview-e2e.mjs",
    "postinstall": "nuxt prepare",
    "prettier": "bunx prettier --write .",
    "prettier:check": "bunx prettier --check .",
    "test:unit": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
    "test:unit:coverage": "NODE_OPTIONS='--max-old-space-size=8192' vitest run --coverage",
    "coverage:server": "sh tests/e2e/server-coverage.sh",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test && bun run test:setup",
    "test:main": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "test:setup": "PLAYWRIGHT_SETUP=1 NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "test:headed": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test --headed",
    "test:coverage": "bun run build:e2e && rm -rf .coverage/server-raw coverage/server && COVERAGE=1 NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test; code=$?; bun run coverage:server; exit $code",
    "test:report": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright show-report",
    "prepare": "husky install"
  },
  "overrides": {
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@libsql/client": "^0.18.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.6.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@types/luxon": "^3.7.6",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "edgeport": "^1.0.6",
    "highlight.js": "^11.12.0",
    "luxon": "^3.7.2",
    "marked": "^18.1.1",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "nuxt-schema-org": "^7.0.1",
    "nuxt-viewport": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codecov/nuxt-plugin": "^2.0.1",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/hints": "^1.1.5",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "c8": "^12.0.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "monocart-reporter": "^2.14.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.0",
    "v8-to-istanbul": "^9.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,vue,css,scss,md,sh,yml}": "prettier --write"
  }
}
